# Aura Storefront — environment template
#
# Copy to `.env.local` and fill in. NEVER commit real values: `.gitignore`
# ignores every `.env*` except this file.
#
# On Vercel these live in Project → Settings → Environment Variables
# (set them for Production *and* Preview — Preview uses its own values).
#
# Nothing here is exposed to the browser except variables prefixed with
# NEXT_PUBLIC_. Tokens and secrets are read only in Server Components,
# Route Handlers and Server Actions.

# ─────────────────────────────────────────────────────────────────────
# Shopify — store
# ─────────────────────────────────────────────────────────────────────

# <store>.myshopify.com — protocol and trailing slash are stripped for you.
SHOPIFY_STORE_DOMAIN=

# ─────────────────────────────────────────────────────────────────────
# Shopify Storefront API  (catalogue, cart, checkoutUrl)
# ─────────────────────────────────────────────────────────────────────

# Private (server-side) Storefront token. Sent as the
# `Shopify-Storefront-Private-Token` header. Server-only — must never
# reach the client bundle.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Optional. Defaults to the version pinned in lib/shopify/client.ts.
# Shopify ships a version quarterly and supports each for 12 months.
SHOPIFY_STOREFRONT_API_VERSION=

# ─────────────────────────────────────────────────────────────────────
# Shopify Customer Account API  (login, orders, addresses)  — Faza 1+
# ─────────────────────────────────────────────────────────────────────

# Confidential client credentials from the Customer Account API app.
# The code→token exchange happens server-side only; the secret must
# never appear in the browser or in Edge middleware.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=

# Optional API version override.
SHOPIFY_CUSTOMER_ACCOUNT_API_VERSION=

# Authorization / token / logout / API endpoints are NOT configured here.
# They are discovered at runtime from the shop's well-known documents
# (`/.well-known/openid-configuration` and
# `/.well-known/customer-account-api`), which is what Shopify recommends —
# hardcoding them goes stale when Shopify rotates hosts.
# Optional pin-overrides, only if discovery ever has to be bypassed:
# SHOPIFY_CUSTOMER_ACCOUNT_AUTHORIZATION_ENDPOINT=
# SHOPIFY_CUSTOMER_ACCOUNT_TOKEN_ENDPOINT=
# SHOPIFY_CUSTOMER_ACCOUNT_LOGOUT_ENDPOINT=
# SHOPIFY_CUSTOMER_ACCOUNT_API_ENDPOINT=

# ─────────────────────────────────────────────────────────────────────
# Session  — Faza 1+
# ─────────────────────────────────────────────────────────────────────

# Signing key for the HttpOnly session cookie. Generate with:
#   openssl rand -base64 32
# Rotating it invalidates every active session (by design).
SESSION_SECRET=

# Public origin of this deployment, no trailing slash. Every OAuth
# redirect and callback URL is built from it — nothing is hardcoded.
#   local:      http://localhost:3000
#   preview:    https://aura-storefront-chi.vercel.app
#   production: https://<domena-produkcyjna>
NEXT_PUBLIC_APP_URL=

# ─────────────────────────────────────────────────────────────────────
# Shopify Admin API  (server-side write path — products only)
# ─────────────────────────────────────────────────────────────────────
#
# Used exclusively by lib/shopify/admin. Never used to read data of a
# logged-in customer — that is Customer Account API territory.
# Leave empty to disable the module entirely.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
SHOPIFY_ADMIN_API_VERSION=

# ─────────────────────────────────────────────────────────────────────
# Development switches
# ─────────────────────────────────────────────────────────────────────

# Serve mock catalogue fixtures instead of Shopify. Ignored in production.
AURA_USE_MOCK_CATALOG=

# Search-engine indexing. UNSET = not indexable (meta noindex + X-Robots-Tag
# on every response). Set to `true` in Vercel Production only, at launch —
# never on Preview. Changing it requires a redeploy.
AURA_ALLOW_INDEXING=
